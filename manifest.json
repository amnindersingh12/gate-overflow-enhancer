{
    "manifest_version": 3,
    "name": "GateOverflow GATE Prep",
    "version": "1.0.0",
    "description": "Personal GATE preparation enhancer for GateOverflow.in – custom tagging, filtering, and quiz features.",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "https://gateoverflow.in/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://gateoverflow.in/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}